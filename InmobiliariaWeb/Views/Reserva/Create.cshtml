@model InmobiliariaWeb.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="container mt-4">
    <h2>Crear Nueva Reserva</h2>
    <hr />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All" class="text-danger mb-0"></div>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">

                <div class="form-group mb-3">
                    <label asp-for="IdInquilino" class="control-label">Inquilino</label>
                    <select asp-for="IdInquilino" class="form-select select2-ajax" required>
                        <option value="">Escriba para buscar un inquilino...</option>
                    </select>
                    <span asp-validation-for="IdInquilino" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IdInmueble" class="control-label">Inmueble</label>
                    <select asp-for="IdInmueble" class="form-select select2-inmueble" required>
                        <option value="">Escriba la dirección...</option>
                    </select>
                    <span asp-validation-for="IdInmueble" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="FechaDesde" class="control-label">Fecha de Inicio</label>
                            <input asp-for="FechaDesde" class="form-control" type="date" required />
                            <span asp-validation-for="FechaDesde" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label asp-for="FechaHasta" class="control-label">Fecha de Fin</label>
                            <input asp-for="FechaHasta" class="form-control" type="date" required />
                            <span asp-validation-for="FechaHasta" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success">Guardar Reserva</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Importa Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
        $('.select2-ajax').select2({
        placeholder: 'Buscar inquilino...',
        minimumInputLength: 2,
        ajax: {
        url: '/Inquilino/BuscarInquilinosAjax',
        dataType: 'json',
        delay: 250,
        data: function (params) {
        return { q: params.term };
        },
        processResults: function (data) {
        return { results: data };
        }
        }
        });
        });

        $('.select2-inmueble').select2({
        placeholder: 'Buscar direccion del inmueble...',
        minimumInputLength: 3,
        ajax: {
        url: '/Inmueble/BuscarInmueblesAjax',
        dataType: 'json',
        delay: 250,
        data: function (params) {
        return { q: params.term };
        },
        processResults: function (data) {
        return { results: data };
        }
        }
        });
    </script>
}