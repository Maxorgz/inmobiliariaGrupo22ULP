@model IEnumerable<InmobiliariaWeb.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Usuarios</h2>
        <a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Avatar</th>
                <th>Nombre y Apellido</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="align-middle">
                        @if (!string.IsNullOrEmpty(item.Avatar))
                        {
                            <img src="@item.Avatar" alt="Avatar" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sin foto</span>
                        }
                    </td>
                    <td class="align-middle">@item.Nombre @item.Apellido</td>
                    <td class="align-middle">@item.Email</td>
                    <td class="align-middle">
                        <span class="badge @(item.RolNombre == "Administrador" ? "bg-danger" : "bg-info")">
                            @item.RolNombre
                        </span>
                    </td>
                    <td class="align-middle">
                        <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>