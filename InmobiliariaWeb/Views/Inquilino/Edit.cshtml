@model InmobiliariaWeb.Models.Inquilino

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-success">
            <div class="card-header bg-success text-white py-3">
                <h2 class="mb-0 fs-4">Editar Inquilino</h2>
            </div>
            
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <input type="hidden" asp-for="IdInquilino" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombre" class="form-label text-secondary fw-bold">Nombre</label>
                            <input asp-for="Nombre" class="form-control shadow-sm" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Apellido" class="form-label text-secondary fw-bold">Apellido</label>
                            <input asp-for="Apellido" class="form-control shadow-sm" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Dni" class="form-label text-secondary fw-bold">DNI</label>
                            <input asp-for="Dni" class="form-control shadow-sm" />
                            <span asp-validation-for="Dni" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono" class="form-label text-secondary fw-bold">Telefono</label>
                            <input asp-for="Telefono" class="form-control shadow-sm" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-4">
                            <label asp-for="Email" class="form-label text-secondary fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control shadow-sm" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar y Volver</a>
                        <button type="submit" class="btn btn-success px-4">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}