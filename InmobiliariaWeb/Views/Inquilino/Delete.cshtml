@model InmobiliariaWeb.Models.Inquilino

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="mb-0 fs-4">Eliminar Inquilino</h2>
            </div>
            
            <div class="card-body p-4">
                <h5 class="text-danger mb-4">¿Estas seguro de eliminar este inquilino?</h5>
                
                <dl class="row">
                    <dt class="col-sm-4 text-secondary">Nombre y Apellido</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Nombre @Model.Apellido</dd>

                    <dt class="col-sm-4 text-secondary">DNI</dt>
                    <dd class="col-sm-8">@Model.Dni</dd>

                    <dt class="col-sm-4 text-secondary">Teléfono</dt>
                    <dd class="col-sm-8">@(Model.Telefono ?? "Sin registrar")</dd>

                    <dt class="col-sm-4 text-secondary">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="IdInquilino" />
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar y Volver</a>
                        <button type="submit" class="btn btn-danger px-4">Si, Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>