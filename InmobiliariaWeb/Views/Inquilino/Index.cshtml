@model IEnumerable<InmobiliariaWeb.Models.Inquilino>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h2 class="mb-0 text-secondary">Lista de Inquilinos</h2>
        <a asp-action="Create" class="btn btn-primary px-4">
            + Nuevo Inquilino
        </a>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light text-secondary">
                <tr>
                    <th class="ps-4">Nombre</th>
                    <th>Apellido</th>
                    <th>DNI</th>
                    <th>Telefono</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th class="text-center pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td class="ps-4">@item.Nombre</td>
                    <td>@item.Apellido</td>
                    <td>@item.Dni</td>
                    <td>@item.Telefono</td>
                    <td>@item.Email</td>

                    <td>
                        @if(item.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    
                    <td class="text-center pe-4">
                        <a asp-action="Edit" asp-route-id="@item.IdInquilino" class="btn btn-outline-secondary btn-sm me-1">Editar</a>
                        @if(item.IsActive)
                        {
                            <a asp-action="Delete" asp-route-id="@item.IdInquilino" class="btn btn-outline-danger btn-sm">Eliminar</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled style="cursor: not-allowed;">Eliminar</button>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>