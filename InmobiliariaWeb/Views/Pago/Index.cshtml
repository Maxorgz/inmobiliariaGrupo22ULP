@model IEnumerable<InmobiliariaWeb.Models.Pago>

@{
    ViewData["Title"] = "Listado de Pagos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Historial de Pagos</h2>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nº Pago</th>
                <th>Reserva Asignada</th>
                <th>Concepto</th>
                <th>Fecha</th>
                <th>Importe</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold">#@item.IdPago</td>
                        <td class="align-middle">
                            @(item.Reserva != null ? $"Reserva #{item.IdReserva}" : $"ID: {item.IdReserva}")
                        </td>
                        <td class="align-middle">@item.Concepto</td>
                        <td class="align-middle">@item.FechaPago.ToShortDateString()</td>
                        <td class="align-middle text-success fw-bold">$@item.Importe</td>
                        <td class="align-middle">
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">Aprobado</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Anulado</span>
                            }
                        </td>
                        <td class="align-middle">
                            <a asp-action="Details" asp-route-id="@item.IdPago" class="btn btn-sm btn-info text-white">Detalles</a>
                            @if (item.Estado)
                            {
                                <form asp-action="Anular" asp-route-id="@item.IdPago" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1" onclick="return confirm('¿Confirma que desea anular este pago?');">
                                        Anular
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No hay pagos registrados en el sistema.</td>
                </tr>
            }
        </tbody>
    </table>
</div>