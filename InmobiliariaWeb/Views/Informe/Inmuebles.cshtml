@model IEnumerable<InmobiliariaWeb.Models.Inmueble>
    
@{
    ViewData["Title"] = "Inmuebles y propietario";
}

<div class="container mt-4">
    <h2>Inmuebles y propietario</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">Volver a Informes</a>

    <form method="get" class="mb-3 d-flex gap-2">
        <select name="disponible" class="form-select" style="max-width:220px" onchange="this.form.submit()">
            <option value="">Todos</option>
            <option value="true" selected="@(ViewBag.Disponible == true)">Disponibles</option>
            <option value="false" selected="@(ViewBag.Disponible == false)">No disponibles</option>
        </select>
    </form>

    <table class="table table-striped">
        <thead><tr><th>Dirección</th><th>Propietario</th><th>Disponible</th></tr></thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Direccion</td>
                    <td>@i.PropietarioNombreCompleto</td>
                    <td>@(i.Disponible ? "Sí" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</div>