@model IEnumerable<InmobiliariaWeb.Models.Pago>

@{
    ViewData["Title"] = "Pagos por reserva";
}

<div class="container mt-4">
    <h2>Pagos de una reserva</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">Volver a Informes</a>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="number" name="idReserva" class="form-control" placeholder="Número de reserva" value="@ViewBag.IdReserva" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    @if (ViewBag.IdReserva != null)
    {
        <div class="mb-3">
            <a asp-controller="Pago" asp-action="Create" asp-route-idReserva="@ViewBag.IdReserva" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> Cargar nuevo pago
            </a>
        </div>

        <table class="table table-striped">
            <thead><tr><th>Concepto</th><th>Fecha</th><th>Importe</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Concepto</td>
                        <td>@p.FechaPago.ToShortDateString()</td>
                        <td>$@p.Importe</td>
                        <td>@(p.Estado ? "Cobrado" : "Anulado")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>