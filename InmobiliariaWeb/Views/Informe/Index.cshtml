@{
    ViewData["Title"] = "Informes";
}

<div class="container mt-4">
    <h2><i class="bi bi-clipboard-data"></i> Informes</h2>
    <hr />
    <div class="list-group">
        <a asp-action="Inmuebles" class="list-group-item list-group-item-action">
            Inmuebles y su propietario
        </a>
        <a asp-action="InmueblesPorPropietario" class="list-group-item list-group-item-action">
            Inmuebles de un propietario específico
        </a>
        <a asp-action="MasReservados" class="list-group-item list-group-item-action">
            Inmuebles más reservados (últimos 365 días)
        </a>
        <a asp-action="SinReservas" class="list-group-item list-group-item-action">
            Inmuebles sin reservas en los últimos X días
        </a>
        <a asp-action="ReservasVigentes" class="list-group-item list-group-item-action">
            Reservas vigentes
        </a>
        <a asp-action="ReservasPorVencer" class="list-group-item list-group-item-action">
            Reservas que terminan en los próximos X días
        </a>
        <a asp-action="InmueblesDisponibles" class="list-group-item list-group-item-action">
            Inmuebles disponibles entre dos fechas
        </a>
        <a asp-action="PagosPorReserva" class="list-group-item list-group-item-action">
            Pagos de una reserva
        </a>
    </div>
</div>