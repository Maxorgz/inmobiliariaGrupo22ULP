@model IEnumerable<InmobiliariaWeb.Models.Reserva>

@{
    ViewData["Title"] = "Reservas vigentes";
}

<div class="container mt-4">
    <h2>Reservas vigentes</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">Volver a Informes</a>

    <table class="table table-striped">
        <thead><tr><th>Inquilino</th><th>Inmueble</th><th>Desde</th><th>Hasta</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@(r.Inquilino != null ? $"{r.Inquilino.Nombre} {r.Inquilino.Apellido}" : $"ID {r.IdInquilino}")</td>
                <td>@(r.Inmueble != null ? r.Inmueble.Direccion : $"ID {r.IdInmueble}")</td>
                <td>@r.FechaDesde.ToShortDateString()</td>
                <td>@r.FechaHasta.ToShortDateString()</td>
                <td>
                    <a asp-controller="Reserva" asp-action="Details" asp-route-id="@r.IdReserva" class="btn btn-sm btn-info">Ver</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>