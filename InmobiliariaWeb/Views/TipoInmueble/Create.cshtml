@model InmobiliariaWeb.Models.TipoInmueble

@{
    ViewData["Title"] = "Nuevo Tipo de Inmueble";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Tipo</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post" class="card p-4 shadow-sm">
                
                <div class="form-group mb-4">
                    <label asp-for="Descripcion" class="control-label fw-bold">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" placeholder="Ej: Casa, Departamento, Local..." required />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                
                <div class="form-group text-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Tipo</button>
                </div>
            </form>
        </div>
    </div>
</div>