@model InmobiliariaWeb.Models.Propietario

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h2 class="mb-0 fs-4">Eliminar Propietario</h2>
            </div>
            
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <strong>¡Atencion!</strong> ¿Estas seguro de eliminar este propietario?
                </div>

                <h5 class="text-secondary border-bottom pb-2 mb-3">Detalles del Propietario</h5>
                
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-secondary">Nombre y Apellido</dt>
                    <dd class="col-sm-8">@Model.Nombre @Model.Apellido</dd>

                    <dt class="col-sm-4 text-secondary">DNI</dt>
                    <dd class="col-sm-8">@Model.Dni</dd>

                    <dt class="col-sm-4 text-secondary">Telefono</dt>
                    <dd class="col-sm-8">@Model.Telefono</dd>

                    <dt class="col-sm-4 text-secondary">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                </dl>

                <form asp-action="Delete" class="mt-4 pt-3 border-top d-flex justify-content-between">
                    <input type="hidden" asp-for="IdPropietario" />
                    
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar y Volver</a>
                    <button type="submit" class="btn btn-danger px-4">Sí, Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>