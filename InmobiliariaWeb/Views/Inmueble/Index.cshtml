@model IEnumerable<InmobiliariaWeb.Models.Inmueble>

@{
    ViewData["Title"] = "Gestión de Inmuebles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Inmuebles</h2>
        <a asp-action="Create" class="btn btn-primary">Nuevo Inmueble</a>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Dirección</th>
                <th>Tipo</th>
                <th>Propietario</th>
                <th>Precio / Día</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold">@item.Direccion</td>
                        <td class="align-middle">
                            @item.PropietarioNombreCompleto
                        </td>
                        <td class="align-middle">
                            @item.TipoInmuebleDescripcion
                        </td>
                        <td class="align-middle text-success fw-bold">$@item.PrecioPorDia</td>
                        <td class="align-middle">
                            <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-warning mb-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-info mb-1">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-danger mb-1">Dar de Baja</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No hay inmuebles registrados en el sistema.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Paginación -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <ul class="pagination shadow-sm">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.Pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>