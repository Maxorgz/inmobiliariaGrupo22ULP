@model InmobiliariaWeb.Models.Inmueble

@{
    ViewData["Title"] = "Nuevo Inmueble";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Inmueble</h2>
    <hr />
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            
            <form asp-action="Create" enctype="multipart/form-data" method="post" class="card p-4 shadow-sm border-top border-primary border-3">
                
                <div class="row mb-3">
                    <div class="col-md-6 form-group">
                        <label asp-for="IdPropietario" class="control-label fw-bold">Propietario</label>
                        <select asp-for="IdPropietario" class="form-select select2-propietario" required>
                            <option value="">Escriba para buscar...</option>
                        </select>
                        <span asp-validation-for="IdPropietario" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-6 form-group">
                        <label asp-for="IdTipoInmueble" class="control-label fw-bold">Tipo de Inmueble</label>
                        <select asp-for="IdTipoInmueble" class="form-select" required>
                            <option value="">Seleccione el tipo...</option>
                            @if(ViewBag.TiposInmueble != null)
                            {
                                foreach (var tipo in ViewBag.TiposInmueble)
                                {
                                    <option value="@tipo.IdTipoInmueble">@tipo.Descripcion</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Direccion" class="control-label fw-bold">Dirección</label>
                    <input asp-for="Direccion" class="form-control" placeholder="Ej: Av. San Martín 1234" required />
                </div>

                <div class="row mb-3">
                    <div class="col-md-4 form-group">
                        <label asp-for="Cupo" class="control-label fw-bold">Cupo (Personas)</label>
                        <input asp-for="Cupo" class="form-control" type="number" min="1" required />
                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="PrecioPorDia" class="control-label fw-bold">Precio / Día ($)</label>
                        <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" required />
                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="PorcentajeReserva" class="control-label fw-bold">% de Reserva</label>
                        <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" value="30.00" required />
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 form-group">
                        <label asp-for="Latitud" class="control-label fw-bold">Latitud (Opcional)</label>
                        <input asp-for="Latitud" class="form-control" type="text" placeholder="Ej: -33.6766" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="Longitud" class="control-label fw-bold">Longitud (Opcional)</label>
                        <input asp-for="Longitud" class="form-control" type="text" placeholder="Ej: -65.4598" />
                    </div>
                </div>

                <div class="form-group mb-4 p-3 bg-light border rounded">
                    <label asp-for="ArchivoImagen" class="control-label fw-bold mb-2">Foto Principal (Opcional)</label>
                    <input asp-for="ArchivoImagen" type="file" accept="image/jpeg, image/png, image/webp" class="form-control" />
                    <small class="form-text text-muted">Podrás subir más fotos a la galería editando el inmueble luego de crearlo.</small>
                </div>
                
                <div class="form-group text-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Inmueble</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Importamos Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('.select2-propietario').select2({
                placeholder: 'Buscar por nombre, apellido o DNI...',
                minimumInputLength: 2,
                ajax: {
                    url: '/Propietario/BuscarPropietariosAjax',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data) {
                        return { results: data };
                    }
                }
            });

            $('.select2-basico').select2();
        });
    </script>
}