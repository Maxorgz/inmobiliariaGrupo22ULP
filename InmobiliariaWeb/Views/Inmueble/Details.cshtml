@model InmobiliariaWeb.Models.Inmueble
@using InmobiliariaWeb.Models

@{
    ViewData["Title"] = "Detalles del Inmueble";
    var imagenes = ViewBag.Imagenes as IList<Imagen> ?? new List<Imagen>();
}

<div class="container mt-4">
    <h2>Detalles del Inmueble #@Model.IdInmueble</h2>
    <hr />

    <div class="col-md-8 mx-auto">
        <div class="card shadow-sm mb-4">
            <div class="card-body text-center p-3">
                @if (imagenes.Any())
                {
                    <div id="carruselInmueble" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner rounded shadow-sm">
                            @for (int i = 0; i < imagenes.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@imagenes[i].Url" class="d-block w-100" style="max-height: 400px; object-fit: cover;" alt="Foto Inmueble">
                                </div>
                            }
                        </div>
                        
                        @if (imagenes.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#carruselInmueble" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                                <span class="visually-hidden">Anterior</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carruselInmueble" data-bs-slide="next">
                                <span class="carousel-control-next-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                                <span class="visually-hidden">Siguiente</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="p-5 bg-light border rounded text-muted">
                        <i class="bi bi-camera" style="font-size: 3rem;"></i>
                        <p class="mt-2 mb-0">Este inmueble no tiene fotos cargadas.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm col-md-8 mx-auto mb-5">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-house-door-fill"></i> Info General</h5>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Direccion</dt>
                <dd class="col-sm-8 fw-bold">@Model.Direccion</dd>

                <dt class="col-sm-4 text-muted mt-3">Propietario</dt>
                <dd class="col-sm-8 mt-3">
                    @if (!string.IsNullOrEmpty(Model.PropietarioNombreCompleto))
                    {
                        <span>@Model.PropietarioNombreCompleto</span>
                    }
                    else
                    {
                        <span>ID: @Model.IdPropietario</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted mt-3">Tipo (ID)</dt>
                <dd class="col-sm-8 mt-3">@Model.IdTipoInmueble</dd>

                <dt class="col-sm-4 text-muted mt-3">Condiciones</dt>
                <dd class="col-sm-8 mt-3">Cupo: @Model.Cupo personas | Reserva minima: @Model.PorcentajeReserva%</dd>

                <dt class="col-sm-4 text-muted mt-3">Precio por Día</dt>
                <dd class="col-sm-8 mt-3 text-success fw-bold fs-5">$@Model.PrecioPorDia</dd>

                @if (Model.Latitud != null && Model.Longitud != null && Model.Latitud != 0 && Model.Longitud != 0)
                {
                    <dt class="col-sm-4 text-muted mt-3">Ubicación (GPS)</dt>
                    <dd class="col-sm-8 mt-3">
                        <a href="https://www.google.com/maps/search/?api=1&query=@(Model.Latitud.ToString().Replace(',', '.'))%2C@(Model.Longitud.ToString().Replace(',', '.'))"
                           target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-geo-alt-fill"></i> Ver en Google Maps
                        </a>
                    </dd>
                }
            </dl>
        </div>
        <div class="card-footer bg-light py-3 d-flex justify-content-end">
            <a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-warning me-2">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
        </div>
    </div>
</div>