@model InmobiliariaWeb.Models.Inmueble
@using InmobiliariaWeb.Models

@{
    ViewData["Title"] = "Editar Inmueble";
    var imagenesActuales = ViewBag.Imagenes as IList<Imagen> ?? new List<Imagen>();
}

<div class="container mt-4">
    <h2>Editar Inmueble #@Model.IdInmueble</h2>
    <hr />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-top border-warning border-3">
                <input type="hidden" asp-for="IdInmueble" />

                <div class="row mb-3">
                    <div class="col-md-6 form-group">
                        <label asp-for="IdPropietario" class="control-label fw-bold">Propietario</label>
                        <select asp-for="IdPropietario" class="form-select" required>
                            <option value="">Seleccione un propietario...</option>
                            @if(ViewBag.Propietarios != null)
                            {
                                foreach (var prop in ViewBag.Propietarios)
                                {
                                    <option value="@prop.IdPropietario">@prop.Nombre @prop.Apellido</option>
                                }
                            }
                        </select>
                    </div>
                    
                    <div class="col-md-6 form-group">
                        <label asp-for="IdTipoInmueble" class="control-label fw-bold">Tipo de Inmueble</label>
                        <select asp-for="IdTipoInmueble" class="form-select" required>
                            <option value="">Seleccione el tipo...</option>
                            @if(ViewBag.TiposInmueble != null)
                            {
                                foreach (var tipo in ViewBag.TiposInmueble)
                                {
                                    <option value="@tipo.IdTipoInmueble">@tipo.Descripcion</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Direccion" class="control-label fw-bold">Dirección</label>
                    <input asp-for="Direccion" class="form-control" required />
                </div>

                <div class="row mb-3">
                    <div class="col-md-4 form-group">
                        <label asp-for="Cupo" class="control-label fw-bold">Cupo (Personas)</label>
                        <input asp-for="Cupo" class="form-control" type="number" min="1" required />
                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="PrecioPorDia" class="control-label fw-bold">Precio / Día ($)</label>
                        <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" required />
                    </div>
                    <div class="col-md-4 form-group">
                        <label asp-for="PorcentajeReserva" class="control-label fw-bold">% de Reserva</label>
                        <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" required />
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 form-group">
                        <label asp-for="Latitud" class="control-label fw-bold">Latitud</label>
                        <input asp-for="Latitud" class="form-control" type="text" placeholder="Ej: -33.6766" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="Longitud" class="control-label fw-bold">Longitud</label>
                        <input asp-for="Longitud" class="form-control" type="text" placeholder="Ej: -65.4598" />
                    </div>
                </div>

                <div class="form-group mb-4 p-3 bg-light border rounded">
                    <label class="control-label fw-bold mb-2">Galería de Imagenes</label>
                    
                    @if (imagenesActuales.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var img in imagenesActuales)
                            {
                                <div class="position-relative d-inline-block" id="foto-box-@img.IdImagen">
                                    <img src="@img.Url" class="img-thumbnail shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Foto" />
                                    
                                    <button type="button" 
                                            class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle shadow" 
                                            style="width: 28px; height: 28px; padding: 0; line-height: 1;"
                                            onclick="eliminarFoto(@img.IdImagen)">
                                        <i class="bi bi-x fw-bold"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3"><i class="bi bi-info-circle"></i> No hay imágenes asociadas a este inmueble.</p>
                    }

                    <label asp-for="ArchivoImagen" class="control-label fw-bold mt-2">Agregar nueva foto (Opcional)</label>
                    <input asp-for="ArchivoImagen" type="file" accept="image/jpeg, image/png, image/webp" class="form-control" />
                    <small class="form-text text-muted">La foto que subas se agrega a la galeria actual.</small>
                </div>
                
                <div class="form-group text-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        async function eliminarFoto(idImagen) {
            
            if (!confirm('¿Estás seguro de que querés borrar esta foto definitivamente?')) {
                return;
            }

            try {
                const response = await fetch(`/Imagenes/Eliminar/${idImagen}`, {
                    method: 'POST'
                });

                if (response.ok) {
                    const cajaFoto = document.getElementById(`foto-box-${idImagen}`);
                    cajaFoto.style.transition = "all 0.3s ease";
                    cajaFoto.style.transform = "scale(0)";
                    cajaFoto.style.opacity = "0";
                    
                    setTimeout(() => {
                        cajaFoto.remove();
                    }, 300);

                } else {
                    alert('No se pudo eliminar la imagen. Verifica los permisos del servidor.');
                }
            } catch (error) {
                console.error('Error en la peticion:', error);
                alert('Hubo un problema al intentar comunicarse con el sistema.');
            }
        }
    </script>
}